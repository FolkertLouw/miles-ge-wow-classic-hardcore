{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FolkertLouw/miles-ge-wow-classic-hardcore/schemas/item.schema.json",
  "title": "Classic Hardcore Item Knowledge Record",
  "type": "object",
  "required": ["itemName", "category", "source"],
  "properties": {
    "itemName": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "gear",
        "quest_item",
        "trade_item",
        "material",
        "consumable",
        "projectile",
        "tool",
        "recipe",
        "trash",
        "vendor_trash",
        "trade_good",
        "container",
        "misc"
      ]
    },
    "subcategory": { "type": ["string", "null"] },
    "type": { "type": ["string", "null"], "description": "Category-specific type, for example leather, meat, food, potion, projectile, tool, mail, leather armor." },
    "quality": { "type": ["string", "null"] },
    "bindType": { "type": ["string", "null"] },
    "taxonomyPath": { "type": ["string", "null"] },
    "gear": {
      "type": ["object", "null"],
      "properties": {
        "armorClass": { "type": ["string", "null"] },
        "slot": { "type": ["string", "null"] },
        "armor": { "type": ["integer", "null"] },
        "usableByDaddyStitchNow": { "type": ["boolean", "null"] },
        "reasonUsabilityUnknown": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "tool": {
      "type": ["object", "null"],
      "properties": {
        "toolType": { "type": ["string", "null"] },
        "requiredForProfession": { "type": ["string", "null"] },
        "weaponSlot": { "type": ["string", "null"] },
        "speed": { "type": ["number", "null"] },
        "damageText": { "type": ["string", "null"] },
        "damagePerSecond": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "projectile": {
      "type": ["object", "null"],
      "properties": {
        "projectileType": { "type": ["string", "null"] },
        "damagePerSecondAdded": { "type": ["number", "null"] },
        "quantityObserved": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "questRelations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "economy": {
      "type": ["object", "null"],
      "properties": {
        "vendorValueCopper": { "type": ["integer", "null"] },
        "purchasePriceCopper": { "type": ["integer", "null"] },
        "auctionHouseObserved": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "string",
      "description": "personally_verified, external_reference, or mixed."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"],
      "default": "high"
    }
  },
  "additionalProperties": true
}
